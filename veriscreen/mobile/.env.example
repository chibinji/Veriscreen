# Optional override. If unset, the app uses the Expo host address on port 8081
# so a phone on the same Wi-Fi can reach the Node student API.
#
# Android emulator:
# EXPO_PUBLIC_API_URL=http://10.0.2.2:8081
#
# iOS simulator:
# EXPO_PUBLIC_API_URL=http://localhost:8081
#
# Physical phone:
# EXPO_PUBLIC_API_URL=http://10.31.110.236:8081
