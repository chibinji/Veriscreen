# Optional override. If unset, the app uses the Expo Metro host IP on port 8081
# so a phone on the same Wi-Fi can reach the Spring Boot backend on your PC.
#
# Android emulator:
# EXPO_PUBLIC_API_URL=http://10.0.2.2:8081
#
# iOS simulator:
# EXPO_PUBLIC_API_URL=http://localhost:8081
#
# Physical device (replace with your PC's LAN IP):
# EXPO_PUBLIC_API_URL=http://192.168.1.10:8081
